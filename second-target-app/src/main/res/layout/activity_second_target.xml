<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSecondTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target App #2: Multi-Package Isolation Audit"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/tvSecondPkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Package: com.example.secondtargetapp"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="12dp" />

        <!-- First Test: Single API (Settings.Secure.ANDROID_ID) Focus Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 TARGET #2 TEST: Settings.Secure.ANDROID_ID"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1D4ED8"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSecondFirstTestStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS: PENDING"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:background="#F1F5F9"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSecondFirstTestExpected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPECTED PROFILE: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondFirstTestActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTUAL VALUE OBSERVED: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondFirstTestDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIAGNOSIS: --"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <!-- Location Verification Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 LOCATION VERIFICATION"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D9488"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSecondLocationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS: PENDING"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:background="#F1F5F9"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSecondLocationExpected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPECTED LOCATION: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTUAL LOCATION: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationLatMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LATITUDE MATCH: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationLngMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LONGITUDE MATCH: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationAltMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALTITUDE MATCH: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationAccMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCURACY MATCH: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationWorldProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WORLD PROFILE: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#1D4ED8"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationSyntheticIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SYNTHETIC TEST IP: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationProfileConsistency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROFILE CONSISTENCY: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#15803D"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationPublicIpNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IP SCOPE NOTICE: Synthetic test IP is application-level; physical network interface/VPN determines actual public IP."
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationHookEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOOK EVENT: LocationManager.getLastKnownLocation()"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondLocationDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIAGNOSIS: --"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <!-- Network Information Verification Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 NETWORK INFORMATION VERIFICATION"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSecondNetworkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS: PENDING"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:background="#F1F5F9"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSecondNetworkExpectedIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPECTED SYNTHETIC IP: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondNetworkWifiIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WIFI_INFO IP (getIpAddress): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondNetworkDhcpIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DHCP_INFO IP (getDhcpInfo): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondNetworkWifiSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WIFI SSID (getSSID): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondNetworkWifiMac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WIFI MAC (getMacAddress): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondNetworkHardwareMac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HARDWARE MAC (NetworkInterface): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSecondNetworkDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIAGNOSIS: --"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSecondRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Android ID Audit &amp; Full Verification"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSecondAuditSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audit Status: Pending"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:background="#E2E8F0"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSecondAuditDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#0F172A"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
