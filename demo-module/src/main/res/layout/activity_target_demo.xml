<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTargetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target App #1: Verification Dashboard"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/tvTargetPkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Package: com.example.demomodule"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="12dp" />

        <!-- First Test: Single API (Settings.Secure.ANDROID_ID) Focus Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 FIRST TEST: Settings.Secure.ANDROID_ID"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1D4ED8"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvFirstTestStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS: PENDING"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:background="#F1F5F9"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvFirstTestExpected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPECTED PROFILE #1: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvFirstTestActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTUAL VALUE OBSERVED: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvFirstTestDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIAGNOSIS: --"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <!-- Location Verification Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 LOCATION VERIFICATION"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D9488"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvLocationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS: PENDING"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:background="#F1F5F9"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvLocationExpected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPECTED LOCATION: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTUAL LOCATION: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationLatMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LATITUDE MATCH: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationLngMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LONGITUDE MATCH: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationAltMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALTITUDE MATCH: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationAccMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCURACY MATCH: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationWorldProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WORLD PROFILE: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#1D4ED8"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationSyntheticIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SYNTHETIC TEST IP: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationProfileConsistency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROFILE CONSISTENCY: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#15803D"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationPublicIpNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IP SCOPE NOTICE: Synthetic test IP is application-level; physical network interface/VPN determines actual public IP."
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationHookEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOOK EVENT: LocationManager.getLastKnownLocation()"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocationDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIAGNOSIS: --"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <!-- Network Information Verification Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 NETWORK INFORMATION VERIFICATION"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNetworkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS: PENDING"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:background="#F1F5F9"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNetworkExpectedIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPECTED SYNTHETIC IP: --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNetworkWifiIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WIFI_INFO IP (getIpAddress): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNetworkDhcpIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DHCP_INFO IP (getDhcpInfo): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNetworkWifiSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WIFI SSID (getSSID): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNetworkWifiMac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WIFI MAC (getMacAddress): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNetworkHardwareMac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HARDWARE MAC (NetworkInterface): --"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNetworkDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIAGNOSIS: --"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Android ID Audit &amp; Full Verification"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvAuditSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audit Status: Pending"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:background="#E2E8F0"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvAuditDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#0F172A"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
